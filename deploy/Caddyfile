# Caddy сам получает и продлевает HTTPS-сертификаты Let's Encrypt для домена из .env и поддомена auth.
{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Только HTTPS: браузер больше не пробует http:// (без preload — домен в списки браузеров не вносим).
		Strict-Transport-Security "max-age=31536000"
		# PWA не встраивается в чужие страницы (clickjacking).
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}

	# Api: REST для PWA и webhook Telegram. Для браузера это тот же origin, что и PWA, — CORS не нужен.
	handle /api/* {
		reverse_proxy api:8080
	}

	# PWA — статика из образа cooking-web (/srv).
	handle {
		root * /srv

		# Файлы с хэшем в имени (assets/index-Bhm4OcCU.js) не меняются никогда — кэш на год.
		# Без запасного index.html: файла старой версии (у открытой до деплоя вкладки) нет — честный 404,
		# а не HTML с кодом 200, который браузер закэшировал бы на год под именем JS-файла.
		handle /assets/* {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		# Остальное (index.html, sw.js, манифест, иконки) — каждый раз сверяться с сервером,
		# иначе новая версия приложения не дойдёт до пользователей.
		# SPA: любой путь приложения (/recipes/…, /auth/callback) — index.html, дальше разберётся роутер.
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}

# Сервер авторизации открыт целиком: страница входа, /connect/*, /.well-known/* (ключи для проверки JWT).
# Caddy сам передаёт X-Forwarded-Proto/For (а пришедшие от клиента подделанные — перезаписывает),
# Auth по ним понимает, что запрос пришёл по HTTPS.
auth.{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		# Страницу входа нельзя встроить в чужой сайт (clickjacking: «Войти» под невидимым iframe).
		# Виджету Telegram это не мешает: там iframe Telegram внутри нашей страницы, а не наоборот.
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
	}

	reverse_proxy auth:8080
}
