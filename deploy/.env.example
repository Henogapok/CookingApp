# Пример .env для deploy/docker-compose.yml. Настоящий .env на сервер пишет workflow деплоя
# из GitHub Secrets/Variables — руками его создавать не нужно и в git он не попадает.

# Домен, на который смотрит A-запись сервера.
DOMAIN=cocking.fyi
# Тег образа Api в GHCR (workflow подставляет SHA коммита; latest — последняя сборка).
API_TAG=latest

# Только [A-Za-z0-9] — так значение не сломает ни строку подключения, ни .env (сгенерировать: openssl rand -hex 32).
POSTGRES_PASSWORD=change-me

# Токен прод-бота от @BotFather.
TELEGRAM_BOT_TOKEN=123456:ABC
# Секрет webhook'а: только [A-Za-z0-9_-], до 256 символов (openssl rand -hex 32).
TELEGRAM_WEBHOOK_SECRET=change-me

# Без ключей Api стартует, но разбор рецептов / расшифровка Reels отвечают «не настроено».
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
